# AI Workspace - copy to .env (Docker Compose reads it automatically) and adjust.
# Never commit .env: it contains secrets.

# ---------------------------------------------------------------------------------------------------------------------
# Host ports
# ---------------------------------------------------------------------------------------------------------------------
FRONTEND_PORT=3080
BACKEND_PORT=8088
POSTGRES_PORT=5434

# ---------------------------------------------------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------------------------------------------------
POSTGRES_DB=aichat
POSTGRES_USER=aichat
POSTGRES_PASSWORD=change-me

# ---------------------------------------------------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------------------------------------------------
# HMAC key for JWTs, at least 32 bytes:  openssl rand -base64 48
JWT_SECRET=
# Administrator created on first start (optional; otherwise the first registered user becomes admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@localhost
# Comma separated browser origins allowed to call the API directly (the bundled nginx uses same-origin)
CORS_ALLOWED_ORIGINS=http://localhost:3080,http://localhost:5173

# ---------------------------------------------------------------------------------------------------------------------
# LLM providers
# ---------------------------------------------------------------------------------------------------------------------
# Provider preselected for new users: openai | qwen | llama
LLM_DEFAULT_PROVIDER=openai

# OpenAI (cloud) - the key stays on the server and is never sent to the browser
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
# Optional allow-list shown in the model selector (empty = discover chat models via GET /v1/models)
OPENAI_MODELS=

# Qwen - default: vLLM container from the "qwen" compose profile (NVIDIA GPU)
QWEN_BASE_URL=http://qwen:8000/v1
QWEN_MODEL=qwen
QWEN_ENGINE=vllm
QWEN_MODELS=
# Qwen via Ollama running on the host instead:
# QWEN_BASE_URL=http://host.docker.internal:11434/v1
# QWEN_MODEL=qwen3:8b
# QWEN_ENGINE=ollama
# QWEN_MODELS=qwen3:8b

# Llama - default: llama.cpp container from the "llama" compose profile (NVIDIA GPU)
LLAMA_BASE_URL=http://llama:8000/v1
LLAMA_MODEL=llama
LLAMA_ENGINE=llama-cpp
LLAMA_MODELS=
# Llama via Ollama running on the host instead:
# LLAMA_BASE_URL=http://host.docker.internal:11434/v1
# LLAMA_MODEL=llama3.1:8b
# LLAMA_ENGINE=ollama
# LLAMA_MODELS=llama3.1:8b

# Audio chat: bundled faster-whisper through Speaches (CPU/int8, no cloud key needed).
# Enabling this with the bundled URL starts the audio profile automatically in deploy/run-dev.
# The first start downloads the model into a persistent Docker volume; change the model to tune speed/accuracy.
AUDIO_TRANSCRIPTION_ENABLED=false
AUDIO_TRANSCRIPTION_BASE_URL=http://faster-whisper:8000/v1
AUDIO_TRANSCRIPTION_MODEL=Systran/faster-whisper-small
# Local placeholder prevents inheriting a cloud key; the loopback-only service does not require authentication.
AUDIO_TRANSCRIPTION_API_KEY=local
AUDIO_TRANSCRIPTION_TIMEOUT=PT120S
AUDIO_MAX_UPLOAD_BYTES=10000000
AUDIO_RATE_LIMIT=10
FASTER_WHISPER_IMAGE=ghcr.io/speaches-ai/speaches:0.9.0-rc.3-cpu
FASTER_WHISPER_PORT=8003
FASTER_WHISPER_COMPUTE_TYPE=int8
FASTER_WHISPER_CPU_THREADS=4
FASTER_WHISPER_STARTUP_TIMEOUT=600

# Model sources for the GPU profiles
QWEN_HF_MODEL=Qwen/Qwen3-8B
LLAMA_GGUF=bartowski/Meta-Llama-3.1-8B-Instruct-GGUF:Q4_K_M
# Hugging Face token (needed for gated models)
HF_TOKEN=

# ---------------------------------------------------------------------------------------------------------------------
# Knowledge base (RAG). Embeddings are configured independently of the chat providers: any chat model can answer
# with knowledge embedded by any embedding model. Changing the embedding model requires "Reindex all" in the admin UI.
# ---------------------------------------------------------------------------------------------------------------------
RAG_ENABLED=true
# OpenAI embeddings (RAG_EMBEDDING_API_KEY defaults to OPENAI_API_KEY)
RAG_EMBEDDING_PROVIDER=openai
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_BASE_URL=https://api.openai.com/v1
RAG_EMBEDDING_API_KEY=
# Local embeddings with Ollama on the host (first: ollama pull qwen3-embedding:0.6b). Any OpenAI-compatible
# /v1/embeddings server works the same way (vLLM, LM Studio, LocalAI, llama.cpp --embeddings).
# RAG_EMBEDDING_PROVIDER=ollama
# RAG_EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
# RAG_EMBEDDING_MODEL=qwen3-embedding:0.6b
# RAG_EMBEDDING_QUERY_PREFIX=Instruct: Given a question, retrieve passages that answer it\nQuery:
# Offline fallback without any embedding model (word hashing: keyword-like matching, no semantics):
# RAG_EMBEDDING_PROVIDER=hashing
# RAG_SIMILARITY_THRESHOLD=0.12
# Minimum cosine similarity of a chunk. The right value depends on the embedding model: calibrate it with
# Admin > Knowledge base > Test retrieval (threshold 0 shows the scores of relevant and unrelated chunks).
RAG_SIMILARITY_THRESHOLD=0.70
# VECTOR or HYBRID (vector + PostgreSQL full-text search merged with reciprocal rank fusion)
RAG_RETRIEVAL_MODE=VECTOR
RAG_TOP_K=8
# Chunk size and overlap in estimated tokens (changes apply to newly indexed or reindexed sources)
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150
# Token budget for knowledge excerpts added to a chat request
RAG_CONTEXT_MAX_TOKENS=6000
# Upload limits; keep NGINX_MAX_UPLOAD_SIZE (nginx syntax) at least RAG_MAX_REQUEST_SIZE
RAG_MAX_FILE_SIZE=50MB
RAG_MAX_REQUEST_SIZE=55MB
NGINX_MAX_UPLOAD_SIZE=55m

# ---------------------------------------------------------------------------------------------------------------------
# Logging: "ecs" or "logstash" for JSON logs, empty string for plain text
# ---------------------------------------------------------------------------------------------------------------------
LOG_FORMAT=ecs
